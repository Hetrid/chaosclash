{
  "rules": {
    ".read": false,
    ".write": false,

    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "queues": {
      "$mode": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['joinedAt'])",
          "joinedAt": { ".validate": "newData.isNumber()" },
          "mmr":      { ".validate": "newData.isNumber()" },
          "$other":   { ".validate": false }
        }
      }
    },

    "lobbies": {
      "$lobbyId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",
          "hostUid": { ".validate": "newData.val() === auth.uid" },
          "$other": { ".validate": true }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (!data.exists() && auth.uid === data.parent().parent().child('meta/hostUid').val()))",
            ".validate": "!newData.exists() || newData.hasChildren(['joinedAt'])",
            "joinedAt": { ".validate": "newData.isNumber()" },
            "role": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "hero": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "spell": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "ready": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "chat": {
          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid','text','at']) && newData.child('text').isString() && newData.child('text').val().length <= 200"
          }
        },
        "$other": { ".validate": false }
      }
    },

    "matches": {
      "$matchId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).exists()",
        ".write": false,
        "meta": { ".validate": false },
        "participants": { "$uid": { ".validate": false } },
        "state": {
          ".write": "auth != null && auth.uid === data.parent().child('meta/hostUid').val()"
        }
      }
    },

    "matchInputs": {
      "$matchId": {
        "$uid": {
          ".read": false,
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['seq','clientTime','input'])",
          "seq": { ".validate": "newData.isNumber()" },
          "clientTime": { ".validate": "newData.isNumber()" },
          "input": { ".validate": true }
        }
      }
    },

    "matchResults": {
      "$matchId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).exists()",
        ".write": false
      }
    },

    "stats": {
      "$uid": {
        ".read": "auth != null",
        ".write": false
      }
    },

    "leaderboards": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
